rules_version = '2';

// Source of truth for this project's Firestore security rules — mirror any
// change here into Firebase Console → Firestore Database → Rules (there's no
// CLI deploy wired up for this repo, so this file and Console must be kept
// in sync manually; see docs/ARCHITECTURE.md §4.2).
//
// Two patterns are used throughout (see CLAUDE.md):
//   - Public read, authenticated write: anything the public portal (index.html)
//     needs to display, or that must be readable *before* a user logs in
//     (e.g. the Magic Word passcode hash, the public access gate password).
//   - Authenticated read and write: PII or internal-only data.
//
// `config` is a single collection holding several unrelated documents
// (see docs/DATA_MODEL.md's "config" section) — each one needs its own
// explicit rule below. A blanket `match /config/{doc}` rule is exactly the
// bug that exposed the Anthropic API key earlier: Firestore rules are OR'd
// across every matching block, so a blanket public-read rule silently wins
// over a more specific authenticated-only rule for the same path. Never
// reintroduce a blanket config rule — add a new document below instead.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── PUBLIC READ, AUTHENTICATED WRITE ─────────────────────────────────
    match /initiatives/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /metrics/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /resources/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /promotions/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bd_cards/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /wellspan_packages/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /loyalty_cards/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /entities/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /health_days/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── AUTHENTICATED READ AND WRITE (PII / internal-only) ───────────────
    match /requests/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /expenses/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /leads/{doc} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
      // First unauthenticated write path in this app: a landing.html visitor
      // is nobody, not even a coordinator, so lead capture there can't
      // require auth. Narrowly scoped — fixed source/contactStatus/outcome
      // (can't fake a "Booked" submission or set assignedAgentUid/
      // revenueValue), field-whitelisted (no arbitrary extra fields), no
      // read access granted at all. This is a real but client-side-only
      // deterrent against a *shaped* bad write, not a defense against a
      // scripted flood — Firestore rules have no rate-limiting/IP concept,
      // and a Cloud Function is out of scope (no backend). Same "deterrent,
      // not a hard boundary" tradeoff already accepted for the Public
      // Access Gate (see ARCHITECTURE.md §4.5). See ARCHITECTURE.md for the
      // full writeup of this exception.
      allow create: if request.auth != null || (
        request.resource.data.source == 'Landing Page' &&
        request.resource.data.contactStatus == 'Untouched' &&
        request.resource.data.outcome == 'Pending' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() < 20 &&
        (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() < 2000)) &&
        request.resource.data.keys().hasOnly(['name','phone','email','source','landingPageId','campaignId','campaign','department','entity','dateCreated','contactStatus','outcome','createdAt','notes'])
      );
    }
    match /landing_pages/{slug} {
      // Anonymous visitors may fetch exactly one Published page by known
      // slug (landing.html), never list the collection — so Draft titles/
      // content stay invisible and a slug can't be discovered by browsing.
      allow get: if resource.data.status == 'Published' || request.auth != null;
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /team_members/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /marketing_actions/{doc} {
      // Executive/marketing action-item tracker — both admin.html's tab and
      // the read-only actions.html leadership view sit behind a real
      // Firebase Auth login (password or Magic Word), so authenticated
      // read/write is correct here — no public-read needed, unlike initiatives.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── ROLES — write restricted to existing admins only ─────────────────
    match /roles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    // ── CONFIG — one explicit rule per document, never a blanket rule ────
    match /config/access_gate {
      // Must be public-read: index.html checks this gate before login exists.
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/admin_passcode {
      // Must be public-read: the Magic Word login flow reads this hash
      // BEFORE the visitor is authenticated — that's the entire point of a
      // passcode-based pre-auth login path. Only a SHA-256 hash is stored
      // here, never the plaintext, so public read is an acceptable tradeoff.
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/lead_stats {
      // Public-readable aggregate, zero PII by design (see DATA_MODEL.md).
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/metricool_stats {
      // Public-readable aggregate, zero PII by design (see DATA_MODEL.md).
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/analytics_settings {
      // Public-read like the two above — a GA4 Measurement ID isn't a
      // secret, landing.html (unauthenticated) needs to read it.
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/budget {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /config/bd_targets {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /config/brand_voice {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /config/ai_settings {
      // Raw Anthropic API key — same sensitivity as metricool_settings below.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /config/metricool_settings {
      // Raw Metricool API token — same sensitivity as ai_settings above.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /config/department_revenue_estimates {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
